{
  "name": "vue-tailwind-4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@prestashopcorp/puik-components": "^2.8.1",
    "@prestashopcorp/puik-theme": "^2.8.1",
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@prestashopcorp/puik-resolver": "^9.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.92.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.92.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0"
    }
  }
}
